PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=change_me
DB_PORT=5432
DB_NAME=change_me
DB_USER=change_me
DB_PASSWORD=change_me_to_a_strong_random_password

# Redis — caches the dashboard-stats/daily/monthly/yearly summary endpoints.
# Optional for local dev: if unset or unreachable, those endpoints just query
# Postgres directly on every request instead of failing.
REDIS_URL=redis://localhost:6379

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_hex_string
JWT_EXPIRES_IN=7d

# Email (SMTP) — leave SMTP_USER empty to disable sending (emails are logged instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Energy Monitoring System <noreply@example.com>

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Data simulator (set to false in production with real hardware)
ENABLE_SIMULATOR=true
SIMULATOR_INTERVAL_MS=5000
