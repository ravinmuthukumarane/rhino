# Copy to .env (git-ignored) and fill in real values before running
# docker compose up. Read by docker-compose.yml via ${VAR} substitution.

# PostgreSQL — used by both the postgres and backend services
DB_PASSWORD=change_me_to_a_strong_random_password

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_hex_string

# Public URL of the deployed frontend (used in password-reset/invite emails)
FRONTEND_URL=http://your-server-ip-or-domain

# Email (SMTP) — leave SMTP_USER empty to disable sending (emails are logged instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Energy Monitoring System <noreply@example.com>
